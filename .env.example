# =============================================================
# NEXUS — орчны хувьсагчдын жишээ (.env.example)
# Энэ файл Git-д орох боломжтой. Бодит .env нээлттэй байхгүй.
#
# Анхаар:
#  - Frontend-ийн SUPABASE_URL / SUPABASE_ANON_KEY утгыг бодитоор
#    src/lib/config.js дотор бичнэ (эндээс уншина уу).
#  - GEMINI_API_KEY зөвхөн Supabase Secret (`supabase secrets set`).
#    Хэзээ ч frontend, localStorage, GitHub руу бичихгүй.
# =============================================================

# ---- Frontend (src/lib/config.js руу хуулбарлана) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# ---- Supabase Edge Function secrets (supabase secrets set ...) ----
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT=30
AI_MAX_TOKENS=900
