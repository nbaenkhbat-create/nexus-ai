{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "location": "us-central1"
  },
  "functions": {
    "source": "functions"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "NEXUS",
        "authorizedRedirectUris": [
          "http://localhost:8090",
          "https://nbaenkhbat-create.github.io"
        ]
      }
    }
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "docs/**",
      ".env*",
      "*.md",
      "_nexus_extract/**"
    ]
  }
}
